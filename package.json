{
  "name": "audio-app-pro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Audio/Video zu Notenschrift - Analyse, Noteneditor, Export, Ubungsmodus",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/copy-ffmpeg-core.mjs && vite",
    "build": "node scripts/copy-ffmpeg-core.mjs && tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare:ffmpeg": "node scripts/copy-ffmpeg-core.mjs",
    "test:e2e": "npm run build && node e2e/run.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@vexflow-fonts/academico": "^1.0.1",
    "@vexflow-fonts/bravura": "^1.0.2",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vexflow": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
